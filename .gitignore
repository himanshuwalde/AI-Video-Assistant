# ── AI Video Assistant — .gitignore ────────────────────────────────────────────

# ── Environment & Secrets ──────────────────────────────────────────────────────
.env

# ── Python virtual environments ────────────────────────────────────────────────
.venv/
venv/
env/

# ── Python bytecode & cache ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pycache

# ── Distribution / packaging ───────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ── Type checking & linting caches ─────────────────────────────────────────────
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.flake8_cache/

# ── Testing & coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
*.cover
htmlcov/
.tox/
.nox/

# ── Frontend ────────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.vite/
frontend/.vite-temp/
frontend/package-lock.json

# ── Project-specific data (large / generated) ──────────────────────────────────
downloads/
vector_db/
*.wav
*.mp3
*.mp4
*.mkv
*.webm

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
logs/

# ── IDE & editor ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Streamlit (if used) ────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Jupyter / Notebooks ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS / misc ──────────────────────────────────────────────────────────────────
*.tmp
*.temp
.cache/

# ── Claude Code local settings ─────────────────────────────────────────────────
.claude/settings.local.json